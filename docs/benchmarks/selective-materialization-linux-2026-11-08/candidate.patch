+func FuzzPreparedObjectPlans(f *testing.F) {
+	for _, raw := range []string{`{"customer":{"name":"Ada"},"meta":{"id":1}}`, `{"customer":{"name":"\ud800"},"meta":{"id":-0}}`, `{"customer":[{"name":"A"}],"meta":{"id":"bad"}}`, `{"meta":{"id":1e308}}`, `null`, `{}`} {
