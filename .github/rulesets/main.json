{
  "name": "Default branch protection",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "test (1.26.x, ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "test (1.26.x, macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "test (stable, ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "test (stable, macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "fuzz",
            "integration_id": 15368
          },
          {
            "context": "reference",
            "integration_id": 15368
          },
          {
            "context": "javascript-assessment",
            "integration_id": 15368
          },
          {
            "context": "javascript-module",
            "integration_id": 15368
          },
          {
            "context": "javascript-windows",
            "integration_id": 15368
          },
          {
            "context": "quickjs-guest-reproducibility",
            "integration_id": 15368
          },
          {
            "context": "scan (linux-amd64, linux, amd64)",
            "integration_id": 15368
          },
          {
            "context": "scan (windows-amd64, windows, amd64)",
            "integration_id": 15368
          },
          {
            "context": "scan (darwin-arm64, darwin, arm64)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
