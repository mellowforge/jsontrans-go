+/* Keep allocation-failure reporting independent of remaining heap space.
+ * Raw contexts retain upstream behavior until their intrinsics are installed;
+ * the owned embedding always uses JS_NewContext. */
+static int init_terminal_oom(JSContext *ctx)
+{
+    JSValue error = JS_NewInternalError(ctx, "out of memory");
+    if (JS_IsException(error))
+        return -1;
+    ctx->terminal_oom = error;
+    return 0;
+}
