+	// deliberately disable fast paths for explicit per-call limits.
+	for _, l := range []budget.Limits{{MaxSteps: 1}, {MaxCollectionItems: 1}, {MaxDepth: 1}} {
+		b, _ := budget.New(ctx, l)
